# Desk app environment. Copy to .env.local for local work (or run `pnpm --filter @sc/desk env:local`
# against a running local Supabase stack). Never put real values in this file.

# Public base URL of the desk (used for sign-in links and redirects).
DESK_SITE_URL=http://127.0.0.1:3000
# Supabase project URL and publishable key (auth only; desk data never uses the Data API).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only Postgres URL for the desk_app role (NOINHERIT, no privileges of its own).
DESK_DATABASE_URL=postgresql://desk_app:replace_me@127.0.0.1:54322/postgres
# Supabase shared pooler, transaction mode (port 6543, for scale-to-zero hosts): set to false.
# Session mode (port 5432) or a direct connection can keep prepared statements on.
DESK_DB_PREPARE=true
# Keyed hash for intake throttling (at least 32 random characters).
INTAKE_HASH_SECRET=replace_with_32_or_more_random_characters
# Stable Server Actions encryption key shared by every instance (32 random bytes, base64).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_me
# Number of reverse proxies in front of the desk that append to X-Forwarded-For. Required in production.
# Throttling trusts only the address the nearest of those proxies appended. 0 means no proxy: every
# client shares one throttle bucket. Local development uses 1 (Next.js fills the header itself).
DESK_TRUSTED_PROXY_HOPS=1
# Agent gateway budget per agent per minute (counted in the database from the audit trail).
DESK_AGENT_RATE_PER_MINUTE=120
# Publishing (ADR-005). The desk builds the public static site and deploys it.
# Public address of the site (used for links, the feed and the sitemap).
SITE_PUBLIC_URL=http://127.0.0.1:4173
# local: write the site into SITE_OUTPUT_DIR (development; serve it with `pnpm site:serve`).
# firebase: deploy to Firebase Hosting (production); needs FIREBASE_SITE_ID and, on Cloud Run, a
# service account allowed to deploy Hosting (no key file).
SITE_DESTINATION=local
SITE_OUTPUT_DIR=.site-output
# FIREBASE_SITE_ID=seafood-confidential
# A staging or pre-launch site: shown on every page; search engines are asked not to index it.
# SITE_PREVIEW_NOTICE=Not launched yet. Stories here are tests by the founders.
# Motion on the public site (sc-visual-codex): calm, standard (default), expressive, or off for a
# still site. Readers can always turn animation off, and prefers-reduced-motion turns it off.
# SITE_MOTION=standard
# Scheduled publishing sweep (Cloud Scheduler): the service account allowed to call
# POST /api/publishing/sweep with a Google-signed token. Unset, the route does not exist.
# PUBLISH_SWEEP_INVOKER=sc-desk-scheduler@<project>.iam.gserviceaccount.com
# Newsletter (optional): Kit API v4 key (secret) and the public signup form ID.
# KIT_API_KEY=
# KIT_FORM_ID=
# KIT_SEGMENT_ID=
# KIT_EMAIL_TEMPLATE_ID=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# OpenTelemetry export (optional), for example:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Never set SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY here: the app refuses to start with one.
