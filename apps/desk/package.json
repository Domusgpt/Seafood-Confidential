{
  "name": "@sc/desk",
  "version": "0.2.0",
  "private": true,
  "description": "Seafood Confidential private operations desk (Next.js 16, Supabase, draft-only agent gateway).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "tokens": "node scripts/build-tokens.mjs",
    "env:local": "node scripts/write-local-env.mjs",
    "staff": "node --env-file=.env.ops.local scripts/staff.ts",
    "agent": "node --env-file=.env.ops.local scripts/agent.ts",
    "scan:bundle": "node scripts/scan-bundle.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@opentelemetry/api": "1.9.1",
    "@sc/contracts": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/otel": "2.3.0",
    "next": "16.4.6",
    "pino": "10.4.0",
    "postgres": "4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
