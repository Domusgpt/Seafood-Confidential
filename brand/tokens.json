{
  "$description": "Seafood Confidential · Working Waterfront design tokens v0.1 (2026-11-18). Brand colors come from editorial/BRAND_GUIDE.md; derived steps were computed to meet WCAG 2.2 AA where the brand values do not. Single source for the project hub and the visual codex. Pending founder approval with the brand guide.",
  "color": {
    "brand": {
      "ink": {
        "$type": "color",
        "$value": "#102B3A",
        "$description": "Masthead, primary text, dark covers, navigation"
      },
      "salt": {
        "$type": "color",
        "$value": "#F3EFE5",
        "$description": "Main background, paper surfaces, light text on ink"
      },
      "sea-glass": {
        "$type": "color",
        "$value": "#7FA59A",
        "$description": "Secondary panels, rules, charts, quiet accents. Decorative on salt (2.36:1); text-capable on ink (5.43:1)"
      },
      "rust": {
        "$type": "color",
        "$value": "#B64D35",
        "$description": "Small emphasis, selected labels, calls to action after contrast testing. 4.46:1 on salt: large text and accents only"
      }
    },
    "derived": {
      "paper-raised": {
        "$type": "color",
        "$value": "#FBF9F4",
        "$description": "Card surface one step above salt"
      },
      "paper-recessed": {
        "$type": "color",
        "$value": "#ECE6D8",
        "$description": "Table headers and recessed panels on salt"
      },
      "ink-2": { "$type": "color", "$value": "#3E5563", "$description": "Secondary text on paper" },
      "ink-muted": {
        "$type": "color",
        "$value": "#52666F",
        "$description": "Captions, metadata, axis labels on paper"
      },
      "rust-text": {
        "$type": "color",
        "$value": "#A24430",
        "$description": "Rust for small text on paper (5.37:1 on salt)"
      },
      "sea-text": {
        "$type": "color",
        "$value": "#3F6B60",
        "$description": "Sea glass for small text on paper (5.25:1 on salt)"
      },
      "harbor": {
        "$type": "color",
        "$value": "#2C5A70",
        "$description": "Links and primary chart marks on paper (6.52:1 on salt)"
      },
      "harbor-range": {
        "$type": "color",
        "$value": "#9DBCCB",
        "$description": "Lighter step of harbor for estimate ranges; values always also in labels and table view"
      },
      "deep": { "$type": "color", "$value": "#0B202C", "$description": "Dark-theme page plane below ink" },
      "ink-raised": {
        "$type": "color",
        "$value": "#173A4D",
        "$description": "Dark-theme recessed panels and table headers"
      },
      "salt-2": { "$type": "color", "$value": "#C5D0CC", "$description": "Secondary text on ink" },
      "salt-muted": { "$type": "color", "$value": "#9FB0AF", "$description": "Captions and metadata on ink" },
      "rust-light": {
        "$type": "color",
        "$value": "#E08A72",
        "$description": "Rust for text on ink (5.63:1)"
      },
      "sea-light": {
        "$type": "color",
        "$value": "#8FB8AB",
        "$description": "Sea glass for text on ink (6.73:1)"
      },
      "harbor-light": {
        "$type": "color",
        "$value": "#8DB8CC",
        "$description": "Links and chart marks on ink (6.90:1)"
      },
      "harbor-range-dark": { "$type": "color", "$value": "#3F6F86", "$description": "Range step on ink" }
    },
    "status": {
      "$description": "Fixed status scale from the dataviz method; always paired with an icon and a label, never color alone.",
      "good": { "$type": "color", "$value": "#0CA30C" },
      "warning": { "$type": "color", "$value": "#FAB219" },
      "serious": { "$type": "color", "$value": "#EC835A" },
      "critical": { "$type": "color", "$value": "#D03B3B" }
    }
  },
  "theme": {
    "light": {
      "paper": "{color.brand.salt}",
      "surface": "{color.derived.paper-raised}",
      "surface-2": "{color.derived.paper-recessed}",
      "ink": "{color.brand.ink}",
      "ink-2": "{color.derived.ink-2}",
      "muted": "{color.derived.ink-muted}",
      "accent": "{color.brand.rust}",
      "accent-text": "{color.derived.rust-text}",
      "sea": "{color.brand.sea-glass}",
      "sea-text": "{color.derived.sea-text}",
      "link": "{color.derived.harbor}",
      "mark": "{color.derived.harbor}",
      "mark-range": "{color.derived.harbor-range}",
      "progress": "{color.derived.harbor}",
      "notice": "{color.status.warning}",
      "notice-text": "{color.brand.ink}"
    },
    "dark": {
      "paper": "{color.derived.deep}",
      "surface": "{color.brand.ink}",
      "surface-2": "{color.derived.ink-raised}",
      "ink": "{color.brand.salt}",
      "ink-2": "{color.derived.salt-2}",
      "muted": "{color.derived.salt-muted}",
      "accent": "{color.derived.rust-light}",
      "accent-text": "{color.derived.rust-light}",
      "sea": "{color.brand.sea-glass}",
      "sea-text": "{color.derived.sea-light}",
      "link": "{color.derived.harbor-light}",
      "mark": "{color.derived.harbor-light}",
      "mark-range": "{color.derived.harbor-range-dark}",
      "progress": "{color.derived.harbor-light}",
      "notice": "{color.status.warning}",
      "notice-text": "{color.brand.ink}"
    },
    "masthead": {
      "background": "{color.brand.ink}",
      "text": "{color.brand.salt}",
      "line": "{color.brand.sea-glass}",
      "index-line": "{color.derived.sea-light}",
      "rule": "{color.brand.rust}"
    }
  },
  "contrast": {
    "$description": "Pairs the hub build asserts. min 4.5 = normal text (WCAG 2.2 AA); 3 = large text or non-text UI.",
    "pairs": [
      { "theme": "light", "text": "ink", "on": "paper", "use": "Body text", "min": 4.5 },
      { "theme": "light", "text": "ink", "on": "surface", "use": "Card text", "min": 4.5 },
      { "theme": "light", "text": "ink", "on": "surface-2", "use": "Table headers", "min": 4.5 },
      { "theme": "light", "text": "ink-2", "on": "paper", "use": "Secondary text", "min": 4.5 },
      { "theme": "light", "text": "ink-2", "on": "surface", "use": "Secondary text on cards", "min": 4.5 },
      { "theme": "light", "text": "muted", "on": "surface", "use": "Captions on cards", "min": 4.5 },
      {
        "theme": "light",
        "text": "muted",
        "on": "surface-2",
        "use": "Captions in table headers",
        "min": 4.5
      },
      { "theme": "light", "text": "link", "on": "paper", "use": "Links", "min": 4.5 },
      { "theme": "light", "text": "link", "on": "surface", "use": "Links on cards", "min": 4.5 },
      { "theme": "light", "text": "accent-text", "on": "surface", "use": "Rust labels on cards", "min": 4.5 },
      {
        "theme": "light",
        "text": "sea-text",
        "on": "surface",
        "use": "Sea-glass labels on cards",
        "min": 4.5
      },
      { "theme": "light", "text": "accent", "on": "paper", "use": "Rust large display text only", "min": 3 },
      { "theme": "light", "text": "mark", "on": "surface", "use": "Chart marks", "min": 3 },
      { "theme": "dark", "text": "ink", "on": "paper", "use": "Body text", "min": 4.5 },
      { "theme": "dark", "text": "ink", "on": "surface", "use": "Card text", "min": 4.5 },
      { "theme": "dark", "text": "ink", "on": "surface-2", "use": "Table headers", "min": 4.5 },
      { "theme": "dark", "text": "ink-2", "on": "surface", "use": "Secondary text on cards", "min": 4.5 },
      { "theme": "dark", "text": "muted", "on": "surface", "use": "Captions on cards", "min": 4.5 },
      { "theme": "dark", "text": "muted", "on": "surface-2", "use": "Captions in table headers", "min": 4.5 },
      { "theme": "dark", "text": "link", "on": "surface", "use": "Links on cards", "min": 4.5 },
      { "theme": "dark", "text": "accent-text", "on": "surface", "use": "Rust labels on cards", "min": 4.5 },
      {
        "theme": "dark",
        "text": "sea-text",
        "on": "surface",
        "use": "Sea-glass labels on cards",
        "min": 4.5
      },
      { "theme": "dark", "text": "mark", "on": "surface", "use": "Chart marks", "min": 3 },
      {
        "theme": "masthead",
        "text": "text",
        "on": "background",
        "use": "Masthead wordmark and copy",
        "min": 4.5
      },
      {
        "theme": "masthead",
        "text": "line",
        "on": "background",
        "use": "Contour lines (decorative, non-text)",
        "min": 3
      },
      {
        "theme": "light",
        "text": "notice-text",
        "on": "notice",
        "use": "Preview banner on the public site",
        "min": 4.5
      },
      {
        "theme": "dark",
        "text": "notice-text",
        "on": "notice",
        "use": "Preview banner on the public site",
        "min": 4.5
      }
    ]
  },
  "typography": {
    "display": {
      "$type": "fontFamily",
      "$value": ["Fraunces", "Iowan Old Style", "Palatino Linotype", "Georgia", "serif"],
      "$description": "Strong editorial serif for masthead and headlines. OFL-1.1 (Undercase Type). Self-hosted variable font: opsz, wght, SOFT, WONK."
    },
    "text": {
      "$type": "fontFamily",
      "$value": ["Source Sans 3", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
      "$description": "Humanist sans for body and interface, including chart figures. OFL-1.1 (Adobe). Self-hosted variable font."
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"]
    }
  }
}
