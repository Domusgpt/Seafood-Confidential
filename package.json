{
  "name": "seafood-confidential",
  "version": "0.7.1",
  "private": true,
  "description": "Seafood Confidential: launch packet, specifications, delivery tracking, project hub and the private operations desk.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "pnpm validate && pnpm test && pnpm desk:check && pnpm hub:build && pnpm hub:check && pnpm format:check",
    "db:reset": "supabase db reset",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,realtime,storage-api,edge-runtime,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "desk:build": "pnpm --filter @sc/desk build && pnpm --filter @sc/desk scan:bundle",
    "desk:check": "pnpm --filter @sc/desk tokens:check && pnpm --filter @sc/desk lint && pnpm --filter @sc/desk typecheck && pnpm --filter @sc/desk test && pnpm --filter @sc/agent-lab typecheck",
    "desk:dev": "pnpm --filter @sc/desk dev",
    "desk:e2e": "pnpm --filter @sc/desk e2e --trace off",
    "desk:env": "pnpm --filter @sc/desk env:local",
    "desk:image": "docker build -f apps/desk/Dockerfile -t sc-desk:local .",
    "devlog:new": "node tools/devlog/cli.mjs new",
    "devtrack": "node tools/devtrack/cli.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hub:build": "node tools/hub/build.mjs",
    "hub:check": "node tools/hub/check.mjs",
    "hub:serve": "node tools/hub/serve.mjs",
    "hub:shots": "node tools/hub/screenshots.mjs",
    "lab": "pnpm --filter @sc/agent-lab lab",
    "lint:actions": "actionlint",
    "lint:secrets": "gitleaks git --no-banner --redact --config .gitleaks.toml . && gitleaks dir --no-banner --redact --config .gitleaks.toml .",
    "lint:shell": "shellcheck tools/bootstrap/*.sh",
    "test": "node --test --test-reporter=spec \"tools/**/*.test.mjs\"",
    "validate": "node tools/validate/cli.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "ajv": "8.20.0",
    "marked": "18.2.1",
    "playwright": "1.63.0",
    "prettier": "3.10.1",
    "supabase": "3.2.0",
    "yaml": "2.9.1"
  }
}
